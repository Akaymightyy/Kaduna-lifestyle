{
  "rules": {
    "players": {
      ".read": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
        ".write": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
        "missions": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid"
        },
        "huntStats": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid"
        },
        "vehicles": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid"
        }
      }
    },
    "economy": {
      ".read": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
      "$uid": {
        ".read": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
        ".write": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
        "balance": {
          ".read": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
          ".write": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'"
        },
        "log": {
          ".read": "auth.uid === $uid",
          "$eventId": {
            ".write": "auth.uid === $uid"
          }
        }
      }
    },
    "chat": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "dms": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "announcements": {
      ".read": "auth != null",
      ".write": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'"
    },
    "events": {
      ".read": "auth != null",
      ".write": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'"
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "daily": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "houses": {
      ".read": "auth != null",
      "$areaId": {
        ".read": "auth != null",
        "$plotNo": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
          "furniture": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "locked": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "forSale": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "forRent": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "price": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "tier": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "colors": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "presence": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "access": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          },
          "party": {
            ".write": "auth != null && root.child('houses/' + $areaId + '/' + $plotNo + '/ownerUid').val() === auth.uid"
          }
        }
      }
    },
    "knocks": {
      "$ownerUid": {
        ".read": "auth.uid === $ownerUid",
        "$knockId": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('visitorUid').val() === auth.uid || $ownerUid === auth.uid)"
        }
      }
    },
    "hunt": {
      ".read": "auth != null",
      "$spotId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (newData.child('claimedBy').val() === auth.uid && newData.child('ts').val() === data.child('ts').val() + 1 || newData.child('ts').val() > data.child('ts').val()))",
        ".validate": "newData.hasChildren(['claimedBy', 'ts', 'reward', 'rarity']) && newData.child('claimedBy').val() === auth.uid && newData.child('ts').isNumber() && newData.child('reward').isNumber() && newData.child('rarity').isString()"
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".read": "auth != null",
        ".write": "!data.exists() && newData.val() === auth.uid"
      }
    },
    "userProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'"
      }
    },
    "billboards": {
      ".read": "auth != null",
      "$billboardId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() === auth.uid || auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1')"
      }
    },
    "billboardReports": {
      ".read": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
      "$reportId": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "worldchat": {
      ".read": "auth != null",
      "$msgId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('members/' + auth.uid).val() === true || data.child('owner').val() === auth.uid)"
        },
        "messages": {
          "$msgId": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || data.child('from').val() === auth.uid)"
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$chatId": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid || root.child('chats/' + $chatId + '/meta/members/' + auth.uid).val() === true"
        }
      }
    },
    "live": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "weather": {
      ".read": "auth != null",
      "$worldId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "traffic": {
      ".read": "auth != null",
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'"
      }
    },
    "challenges": {
      ".read": "auth != null",
      "$challengeId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('opponentUid').val() === auth.uid || (data.child('status').val() === 'open' && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'active')))"
      }
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('players/' + auth.uid).val() != null",
        ".write": "auth != null && (!data.exists() || data.child('players/' + auth.uid).val() != null)"
      }
    },
    "houseChat": {
      ".read": "auth != null",
      "$room": {
        ".read": "auth != null",
        "$msg": {
          ".write": "auth != null && newData.child('uid').val() === auth.uid"
        }
      }
    },
    "sprays": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('fromUid').val() === auth.uid"
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$id": {
          ".write": "auth != null"
        }
      }
    }
  }
}
