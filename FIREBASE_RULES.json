    "crewMembers": {
      ".read": "auth != null",
      "$crewId": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('crewMembers/' + $crewId + '/' + auth.uid + '/role').val() === 'leader' || (root.child('crewMembers/' + $crewId + '/' + auth.uid + '/role').val() === 'coleader' && data.child('role').val() === 'member'))",
          ".validate": "newData.hasChildren(['name', 'role', 'joinedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
          },
          "role": {
            ".write": "auth != null && (root.child('crewMembers/' + $crewId + '/' + auth.uid + '/role').val() === 'leader' || (root.child('crewMembers/' + $crewId + '/' + auth.uid + '/role').val() === 'coleader' && data.val() === 'member'))",
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "joinedAt": {
            ".validate": "newData.isNumber()"
          },
          "contributed": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000 && (!data.exists() || newData.val() >= data.val())"
          },
          "cred": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && (!data.exists() || newData.val() >= data.val())"
          },
          "weeklyPts": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          }
        }
      }
    },
    "crewNames": {
      ".read": "auth != null",
      "$name": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
      }
    },
    "crewTags": {
      ".read": "auth != null",
      "$tag": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 5"
      }
    },
    "crewChat": {
      "$crewId": {
        ".read": "auth != null && root.child('crewMembers/' + $crewId + '/' + auth.uid).exists()",
        "$msgId": {
          ".write": "auth != null && root.child('crewMembers/' + $crewId + '/' + auth.uid).exists() && !data.exists()",
          ".validate": "newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 400 && newData.child('ts').isNumber()"
        }
      }
    },
    "territory": {
      ".read": "auth != null",
      "$areaId": {
        ".write": "auth != null && (!data.exists() || newData.child('week').val() !== data.child('week').val())",
        "crewId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "crewName": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "tag": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 9"
        },
        "since": {
          ".validate": "newData.isNumber()"
        },
        "week": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "resolvedWeek": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "war": {
          "$week": {
            "$crewId": {
              ".write": "auth != null && root.child('crewMembers/' + $crewId + '/' + auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && (!data.exists() || newData.val() > data.val()) && (!data.exists() || newData.val() - data.val() <= 5000)"
            }
          }
        },
        "cooldowns": {
          "$crewId": {
            ".write": "auth != null && root.child('crewMembers/' + $crewId + '/' + auth.uid).exists()",
            ".validate": "newData.isNumber()"
          }
        },
        "claims": {
          "$day": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('players/' + auth.uid + '/crew/crewId').val() === root.child('territory/' + $areaId + '/crewId').val()",
              ".validate": "newData.hasChildren(['amount', 'ts']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 1000 && newData.child('amount').val() <= 500000 && newData.child('ts').isNumber()"
            }
          }
        },
        "rewards": {
          "$week": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('players/' + auth.uid + '/crew/crewId').val() === root.child('territory/' + $areaId + '/crewId').val()",
              ".validate": "newData.hasChildren(['amount', 'ts']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 1000 && newData.child('amount').val() <= 500000 && newData.child('ts').isNumber()"
            }
          }
        }
      }
    },
    "transfers": {
      ".read": "auth.uid === '6U87PzWq0dU8qwZeXJo7ySLxOFo1'",
      "$txId": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.child('from').val() === auth.uid && newData.child('to').isString() && newData.child('to').val().length <= 128 && newData.child('to').val() !== auth.uid && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && newData.child('amount').val() <= 10000000 && newData.child('ts').isNumber() && (!newData.child('note').exists() || newData.child('note').isString())"
      }
    },
    "capsules": {
      ".read": "auth != null",
      "$id": {
        "owner": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "ownerName": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "x": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
        },
        "z": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 100000"
        },
        "kind": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === 'days' || newData.val() === 'friend'"
        },
        "forUid": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "forName": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "unlockAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "days": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "refunded": {
          ".write": "auth != null && !data.exists() && data.parent().child('owner').val() === auth.uid && !data.parent().child('claim').exists()",
          ".validate": "newData.val() === true"
        },
        "notified": {
          ".write": "auth != null && data.parent().child('owner').val() === auth.uid",
          ".validate": "newData.val() === true"
        },
        "claim": {
          ".write": "auth != null && (!data.exists() || (data.child('by').val() === auth.uid && data.child('paid').val() === false))",
          ".validate": "newData.child('by').val() === auth.uid && newData.child('at').isNumber() && (newData.child('paid').val() === true || newData.child('paid').val() === false)",
          "by": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "paid": {
            ".validate": "newData.val() === true || newData.val() === false"
          }
        },
        ".write": "auth != null && newData.val() === null && data.child('owner').val() === auth.uid && (data.child('refunded').val() === true || data.child('claim/paid').val() === true)"
      }
    },
    "capsuleSecrets": {
      "$id": {
        ".read": "auth != null && (root.child('capsules/' + $id + '/owner').val() === auth.uid || root.child('capsules/' + $id + '/forUid').val() === auth.uid || (root.child('capsules/' + $id + '/kind').val() === 'days' && now >= root.child('capsules/' + $id + '/unlockAt').val()) || root.child('capsules/' + $id + '/claim').exists())",
        ".write": "auth != null && ((!data.exists() && newData.hasChildren(['text', 'gift']) && root.child('capsules/' + $id).exists() === false) || (newData.val() === null && root.child('capsules/' + $id + '/owner').val() === auth.uid && (root.child('capsules/' + $id + '/refunded').val() === true || root.child('capsules/' + $id + '/claim/paid').val() === true || root.child('capsules/' + $id).exists() === false)))",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "gift": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
        }
      }
    }
  }
}
